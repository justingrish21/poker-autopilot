---
export interface Props {
	title: string;
}

const { title } = Astro.props;
---
<footer class="mx-auto max-w-xl px-5 pb-10 text-center text-sm text-gray-500">
    <p>&copy; {new Date().getFullYear()} {title}. Play-money poker for fun and practice. No real-money gambling.</p>
    <p class="mt-1">Made with <a href="https://github.com/yoanbernabeu/LinkTreeFreeClone" class="text-gray-400 underline">LinkTreeFreeClone</a></p>
</footer>
