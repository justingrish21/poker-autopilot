---
export interface Props {
	title: string;
	emoji: string;
	href: string;
	primary?: boolean;
}

const { title, emoji, href, primary } = Astro.props;
const base = "flex w-full items-center justify-center gap-3 rounded-2xl px-6 py-5 text-center text-lg font-bold shadow-lg transition hover:-translate-y-0.5 hover:shadow-2xl focus:outline-none focus:ring-4";
const style = primary
	? "bg-yellow-400 text-gray-900 ring-yellow-200 focus:ring-yellow-200 animate-pulse-slow"
	: "border-2 border-white/15 bg-white/10 text-white backdrop-blur focus:ring-white/30";
---

<a href={href} class={`${base} ${style}`} target="_blank" rel="noopener">
    <span class="text-2xl">{emoji}</span>
    <span>{title}</span>
</a>
