---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Link from "../components/Link.astro";
import Footer from "../components/Footer.astro";
import { SUBTITLE, TITLE, TAGLINE, HOW_IT_WORKS } from "../config";

// every Markdown file in ./links is a button, sorted by its `order`
const links = (await Astro.glob("../data/links/*.md")).sort(
	(a, b) => (a.frontmatter.order ?? 99) - (b.frontmatter.order ?? 99)
);
---

<Layout title={`${TITLE} | ${SUBTITLE}`} description={TAGLINE}>
    <Header subtitle={SUBTITLE} title={TITLE} tagline={TAGLINE} />

    <main class="mx-auto max-w-xl px-5">
        <div class="flex flex-col gap-4">
            {links.map((link) => (
                <Link emoji={link.frontmatter.emoji} title={link.frontmatter.title}
                      href={link.frontmatter.href} primary={link.frontmatter.primary}
                      note={link.frontmatter.note} />
            ))}
        </div>

        <section class="mt-10 rounded-2xl border border-white/10 bg-black/30 p-6">
            <h2 class="text-center text-xl font-extrabold text-yellow-400">How it works</h2>
            <ol class="mt-4 space-y-3">
                {HOW_IT_WORKS.map((step, i) => (
                    <li class="flex gap-3 text-base font-semibold text-gray-200">
                        <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-yellow-400 font-extrabold text-gray-900">{i + 1}</span>
                        <span class="pt-1">{step}</span>
                    </li>
                ))}
            </ol>
        </section>
    </main>

    <Footer title={TITLE} />
</Layout>
